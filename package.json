{
  "name": "ore-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "pnpm build:libs && pnpm --filter @ore-ui/docs dev",
    "build": "pnpm build:libs && pnpm --filter @ore-ui/docs build",
    "build:libs": "pnpm --filter @ore-ui/react build && pnpm --filter @ore-ui/svelte build",
    "check": "pnpm -r --if-present check",
    "test": "vitest run",
    "verify": "pnpm build:libs && pnpm check && pnpm test && pnpm --filter @ore-ui/docs build"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "tsup": "^8.5.0",
    "vitest": "^3.2.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/svelte": "^5.2.8",
    "@testing-library/jest-dom": "6.9.1",
    "jsdom": "^26.1.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "svelte": "^5.43.0"
  }
}
